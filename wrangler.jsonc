{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startside",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "lmfaole.party/start*", "zone_name": "lmfaole.party" }],
  "vars": {
    "WEATHER_PLACE": "Oslo",
    "WEATHER_LAT": "59.91",
    "WEATHER_LON": "10.75",
    // The relay the page fetches its sources through (upstream/); its key is the secret UPSTREAM_KEY.
    "UPSTREAM_URL": "https://startside-upstream.olejorgenbakken.workers.dev"
  }
}
