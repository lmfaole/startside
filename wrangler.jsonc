{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startside",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the route: no workers.dev or preview address that would get round Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "lmfaole.party/start*", "zone_name": "lmfaole.party" }],
  "vars": {
    // GitHub: the repositories whose issues are watched (the ones you are involved in, new ones nobody owns, what moved lately).
    "GITHUB_WATCH_REPOS": "fremtind/jokul",
    "WEATHER_PLACE": "Oslo",
    "WEATHER_LAT": "59.91",
    "WEATHER_LON": "10.75",
    // The relay the page fetches its sources through (upstream/); its key is the secret UPSTREAM_KEY.
    "UPSTREAM_URL": "https://startside-upstream.olejorgenbakken.workers.dev"
  }
}
